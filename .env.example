# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role Key (Admin paneli kullanıcı oluşturma için)
# Dashboard > Project Settings > API > Service Role key
# Bu değer ASLA client'a açılmaz, sadece sunucu tarafında kullanılır
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Uygulama Bilgileri (opsiyonel)
NEXT_PUBLIC_APP_NAME=Saha Satış Takip
NEXT_PUBLIC_COMPANY_NAME=Baskı Şirketi A.Ş.
